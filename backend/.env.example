# お問い合わせ通知メールの送信設定(Resend: https://resend.com 無料枠あり)
# 1. https://resend.com でアカウント作成(クレジットカード不要)
# 2. ダッシュボードの「API Keys」からAPIキーを発行してRESEND_API_KEYに設定
# 3. 独自ドメインを認証しない場合、送信元は onboarding@resend.dev のままでOK
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# 通知の送信先(お問い合わせがあったときに届くアドレス)
# 独自ドメインをResendで認証していない場合、Resend登録アドレス宛にしか送信できない点に注意
CONTACT_NOTIFY_EMAIL=truehappy09182@gmail.com

# 本番フロントエンドのオリジン(CORS許可用、カンマ区切りで複数指定可)
FRONTEND_ORIGINS=https://your-site.vercel.app
