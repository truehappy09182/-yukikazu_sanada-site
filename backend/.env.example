# お問い合わせ通知メールの送信元アカウント設定
# Gmailの場合は2段階認証を有効にし、アプリパスワードを発行してSMTP_PASSWORDに設定してください
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASSWORD=your-app-password

# 通知の送信先(お問い合わせがあったときに届くアドレス)
CONTACT_NOTIFY_EMAIL=masa09english@gmail.com

# 本番フロントエンドのオリジン(CORS許可用、カンマ区切りで複数指定可)
FRONTEND_ORIGINS=https://your-site.vercel.app
